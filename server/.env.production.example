# Server environment for a production deployment (e.g. Railway).
# Set these as service variables in the platform — do NOT commit real values.

# Required. NODE_ENV=production makes the server REFUSE to boot with the dev
# JWT secret, so JWT_SECRET must be a strong random string.
NODE_ENV=production
JWT_SECRET=replace-with-a-long-random-string

# Bind on all interfaces inside the container (the Dockerfile already sets this).
HOST=0.0.0.0
# PORT is provided by the platform automatically — do not hardcode it.

# Persist the SQLite database on a mounted volume so it survives restarts.
DB_PATH=/data/wardline.db

# Which browser origin(s) may call the API (the deployed dashboard).
CORS_ORIGINS=https://wardline.app

# Where the dashboard lives — used to build the links in verification,
# password-reset, and invite emails (e.g. https://wardline.app/?verify=...).
APP_URL=https://wardline.app

# Outbound email (account verification, password reset, co-parent invites).
# Without a key, "sending" an email just logs it to the server console — the
# whole flow still works end-to-end for local dev/testing, it just doesn't
# reach a real inbox. Get a key at https://resend.com and verify a sending
# domain there before going live.
# RESEND_API_KEY=re_...
# MAIL_FROM=Wardline <noreply@wardline.app>

# Skip seeding the demo household entirely, so the deployment starts empty and
# real users sign up via "Create a household". Recommended for production.
WARDLINE_DISABLE_DEMO_SEED=1

# Only used if the demo seed is NOT disabled: the seeded demo account's password.
# DEMO_PASSWORD=replace-with-a-private-password

# Optional — enables the hybrid AI classifier. Without it, the rule engine runs.
# ANTHROPIC_API_KEY=sk-ant-...
# WARDLINE_CLAUDE_MODEL=claude-haiku-4-5
