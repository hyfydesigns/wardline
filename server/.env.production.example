# Server environment for a production deployment (e.g. Railway).
# Set these as service variables in the platform — do NOT commit real values.

# Required. NODE_ENV=production makes the server REFUSE to boot with the dev
# JWT secret, so JWT_SECRET must be a strong random string.
NODE_ENV=production
JWT_SECRET=replace-with-a-long-random-string

# Bind on all interfaces inside the container (the Dockerfile already sets this).
HOST=0.0.0.0
# PORT is provided by the platform automatically — do not hardcode it.

# Persist the SQLite database on a mounted volume so it survives restarts.
DB_PATH=/data/wardline.db

# Which browser origin(s) may call the API (the deployed dashboard).
CORS_ORIGINS=https://wardline.app

# Password for the seeded demo account (renee@family.wardline.app). Set this so
# a public deployment isn't logged into with the repo's default.
DEMO_PASSWORD=replace-with-a-private-password

# Optional — enables the hybrid AI classifier. Without it, the rule engine runs.
# ANTHROPIC_API_KEY=sk-ant-...
# WARDLINE_CLAUDE_MODEL=claude-haiku-4-5
