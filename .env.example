# Copy this file to ".env" (in the repo root) and fill in your key.
# ".env" is gitignored — never commit real secrets.
# Real shell environment variables take precedence over anything set here.

# Anthropic API key — enables the AI (hybrid) classifier. Get one at
# https://console.anthropic.com  →  API keys.  Leave unset to run rule-only.
ANTHROPIC_API_KEY=

# Classifier backing: rules | hybrid | claude
# Omit to auto-select: hybrid when a key is present, otherwise rules.
# WARDLINE_CLASSIFIER=hybrid

# Model used by the hybrid/claude modes. Default: claude-haiku-4-5 (fast, cheap).
# Point at a more capable model for harder judgement calls.
# WARDLINE_CLAUDE_MODEL=claude-opus-4-8

# Set to 1 to log when a model call fails and falls back to the rule engine.
# WARDLINE_DEBUG=1
