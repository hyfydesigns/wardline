# Production build config for the dashboard.
#
# Vite bakes VITE_* vars into the build. Set this to your API origin so the
# deployed dashboard (wardline.app) knows where the backend lives.
#
# You can either copy this to web/.env.production, or set VITE_API_URL as a
# build environment variable in the Cloudflare Pages project settings.

VITE_API_URL=https://api.wardline.app
